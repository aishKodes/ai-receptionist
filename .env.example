# Public production URL
APP_URL=https://crm.radianceclinics.com
PUBLIC_WEBHOOK_BASE_URL=https://crm.radianceclinics.com
TZ=Asia/Kolkata

# Verified clinic facts shown to patients (leave blank until confirmed)
CLINIC_DOCTOR_TITLE=
CLINIC_PHONE=
CLINIC_ADDRESS=
CLINIC_WEBSITE=

# Dashboard authentication (generate with: npm run auth:hash-pin -- 12345678)
ADMIN_PIN_HASH=
SESSION_SECRET=

# Persistence: use sqlite only for local development; Hostinger production uses mysql
DATABASE_PROVIDER=mysql
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
RADIANCE_DB_PATH=data/radiance.db

# AI providers (server-side only)
AI_PRIMARY_PROVIDER=deepseek
AI_PRIMARY_MODEL=deepseek-flash
AI_LANGUAGE_FALLBACK_PROVIDER=gemini
AI_LANGUAGE_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_COMPLEX_FALLBACK_PROVIDER=gemini
AI_COMPLEX_FALLBACK_MODEL=gemini-3.8-flash
AI_ALLOW_FALLBACK=true
AI_CONFIDENCE_THRESHOLD=0.58
AI_FALLBACK_TO_MOCK=false
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# WhatsApp Cloud API and coexistence
MESSAGE_CHANNEL=whatsapp
WHATSAPP_ENABLED=false
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set the WABA ID below. WHATSAPP_WABA_ID is preferred; the second name remains
# for compatibility with an existing Hostinger environment.
WHATSAPP_WABA_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE=
WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US
WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE=
WHATSAPP_NO_SHOW_TEMPLATE=
HUMAN_LOCK_MINUTES=30

# Hostinger cron calls POST /api/internal/process-jobs with this Bearer secret
CRON_SECRET=
OUTREACH_MESSAGES_PER_MINUTE=5
AUTO_MARKETING_DAILY_LIMIT=10
MARKETING_OUTREACH_COOLDOWN_DAYS=7
AUTO_MARKETING_ENABLED=false

# This route can only run on localhost and must remain disabled in production.
ENABLE_LOCAL_TEST_PANEL=false
