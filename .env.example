# Public production URL
APP_URL=https://crm.radianceclinics.com
PUBLIC_WEBHOOK_BASE_URL=https://crm.radianceclinics.com

# Dashboard authentication (generate with: npm run auth:hash-pin -- 123456)
ADMIN_PIN_HASH=
SESSION_SECRET=

# Persistence: use sqlite only for local development; Hostinger production uses mysql
DATABASE_PROVIDER=mysql
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
RADIANCE_DB_PATH=data/radiance.db

# AI providers (server-side only)
AI_PRIMARY_PROVIDER=deepseek
AI_PRIMARY_MODEL=deepseek-chat
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_MODEL=gemini-3.6-flash
AI_ALLOW_FALLBACK=true
AI_CONFIDENCE_THRESHOLD=0.58
AI_FALLBACK_TO_MOCK=false
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# WhatsApp Cloud API and coexistence
MESSAGE_CHANNEL=whatsapp
WHATSAPP_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE=
WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US
WHATSAPP_APPOINTMENT_REMINDER_TEMPLATE=
WHATSAPP_NO_SHOW_TEMPLATE=
HUMAN_LOCK_MINUTES=30

# Hostinger cron calls POST /api/internal/process-jobs with this Bearer secret
CRON_SECRET=
OUTREACH_MESSAGES_PER_MINUTE=5
