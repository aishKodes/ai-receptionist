# AI providers (keys stay server-side)
AI_PRIMARY_PROVIDER=deepseek
AI_PRIMARY_MODEL=deepseek-v4-flash
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_MODEL=gemini-3.7-flash
AI_ALLOW_FALLBACK=true
AI_CONFIDENCE_THRESHOLD=0.58
AI_FALLBACK_TO_MOCK=true
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Demo
DEMO_MODE=true
DEMO_REMINDER_1_SECONDS=45
DEMO_REMINDER_2_SECONDS=90

# Messaging: local | mock_meta | whatsapp
MESSAGE_CHANNEL=local
OUTREACH_MESSAGES_PER_MINUTE=5

# Optional Meta WhatsApp Cloud API
WHATSAPP_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE=
WHATSAPP_TEST_TEMPLATE_LANGUAGE=en_US
PUBLIC_WEBHOOK_BASE_URL=
