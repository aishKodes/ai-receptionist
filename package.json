{
  "name": "radiance-ai-reception",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:worker": "tsx scripts/worker.ts",
    "setup": "tsx scripts/setup.ts",
    "db:push": "tsx scripts/setup.ts",
    "db:seed:test": "RADIANCE_ALLOW_FIXTURES=true tsx scripts/seed.ts",
    "db:reset:test": "RADIANCE_ALLOW_FIXTURES=true tsx scripts/setup.ts --seed-test --reset-test",
    "db:generate": "drizzle-kit generate",
    "db:mysql:migrate": "tsx scripts/mysql-migrate.ts",
    "db:production-check": "tsx scripts/production-db-check.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:conversation-quality": "vitest run tests/conversation-quality.test.ts",
    "eval:models": "tsx scripts/eval-models.ts",
    "smoke:conversations": "tsx scripts/smoke-conversations.ts",
    "build": "next build --webpack",
    "start": "next start",
    "auth:hash-pin": "tsx scripts/hash-pin.ts",
    "production:clean": "tsx scripts/production-cleanup.ts --apply",
    "predeploy": "tsx scripts/predeploy.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "mysql2": "^3.24.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.126.0"
  },
  "type": "module"
}
